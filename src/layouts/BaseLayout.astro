---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import KonamiEgg from '../components/KonamiEgg.astro';
import WorldCupBall from '../components/WorldCupBall.astro';
import '../styles/global.css';

const {
  pageTitle = "My Portfolio",
  pageDescription = "Jay Wyss — systems, data, and public affairs.",
  ogImage = "/og-image.png",
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Jay Wyss" href="/rss.xml" />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline defer data-domain="jaywyss.me" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <!--
      You're the kind of person who reads page source. Respect.
      Some say there's a classic cheat code that still works on this site.
      Up, up, down, down... you know the rest.
    -->
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <KonamiEgg />
    <WorldCupBall />
  </body>
</html>