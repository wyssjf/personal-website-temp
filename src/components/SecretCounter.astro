<p id="secret-counter" class="secret-counter-static"></p>

<script>
  import { ACHIEVEMENTS, getAchievements } from '../lib/achievements.js';

  const counter = document.getElementById('secret-counter');

  const encouragement = [
    "There's a secret challenge hidden on this site...",
    "You're warm. Keep poking around.",
    "Almost there. One more to go.",
    "You found them all! 🎉",
  ];

  function updateCounter() {
    if (!counter) return;
    const unlocked = getAchievements();
    const found = ACHIEVEMENTS.filter((a) => unlocked[a.id]).length;
    const total = ACHIEVEMENTS.length;
    counter.textContent = `${found} / ${total} secrets — ${encouragement[found]}`;
  }

  updateCounter();
  window.addEventListener('achievements-updated', updateCounter);
</script>
