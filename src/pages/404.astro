---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Page Not Found | Jay Wyss" pageDescription="This page doesn't exist.">
  <div class="page-intro not-found">
    <span class="eyebrow">404</span>
    <img
      src="https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExOTE4OGlqa3JrcGU0YWwzZTVxZjVlb3Qxd3ZpaGtnbWVsdjh0eThnciZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/3eAVX0wkVHzoz48XXe/giphy.gif"
      alt=""
      class="not-found-gif"
    />
    <h1>Page not found</h1>
    <p>Whatever you were looking for, it isn't here. Let's get you back on track.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Go Home</a>
      <a class="btn btn-ghost" href="https://google.com" target="_blank" rel="noopener noreferrer">Google.com</a>
    </div>
  </div>
</BaseLayout>
