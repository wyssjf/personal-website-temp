---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Secret Arcade | Jay Wyss" pageDescription="You found it." noindex={true}>
  <div class="page-intro">
    <span class="eyebrow">Shh</span>
    <h1>Welcome to the SECRET Arcade</h1>
    <p>There's no link to this page anywhere on the site — you either followed a clue or got lucky. Here's everything hidden around here, found or not.</p>
  </div>

  <section class="section">
    <p id="achievement-progress" class="achievement-progress"></p>
    <div id="achievement-list" class="achievement-list"></div>
  </section>

  <section id="achievement-reward" class="section" hidden>
    <div class="arcade">
      <div class="arcade-header">
        <span class="eyebrow">Secret Arcade</span>
        <h2>Pick your game</h2>
      </div>
      <div class="arcade-tabs" role="tablist">
        <button class="arcade-tab is-active" type="button" data-game="hextris">Hextris</button>
        <button class="arcade-tab" type="button" data-game="2048">2048</button>
        <button class="arcade-tab" type="button" data-game="pacman">Pac-Man</button>
      </div>
      <iframe id="arcade-frame" src="/arcade/hextris/index.html" title="Arcade game" loading="lazy" class="arcade-frame"></iframe>
      <p class="arcade-credit">
        Bonus games, vendored as-is and unmodified except for stripped analytics:
        <a href="https://github.com/Hextris/hextris" target="_blank" rel="noopener noreferrer">Hextris</a> (GPLv3),
        <a href="https://github.com/gabrielecirulli/2048" target="_blank" rel="noopener noreferrer">2048</a> (MIT),
        <a href="https://github.com/daleharvey/pacman" target="_blank" rel="noopener noreferrer">Pac-Man clone</a> (WTFPL).
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { ACHIEVEMENTS, getAchievements } from '../lib/achievements.js';
  import { launchConfetti } from '../lib/confetti.js';

  const list = document.getElementById('achievement-list');
  const progress = document.getElementById('achievement-progress');
  const reward = document.getElementById('achievement-reward');
  const unlocked = getAchievements();
  const foundCount = ACHIEVEMENTS.filter((a) => unlocked[a.id]).length;

  if (progress) {
    progress.textContent = `${foundCount} / ${ACHIEVEMENTS.length} found`;
  }

  if (list) {
    list.innerHTML = ACHIEVEMENTS.map((a) => {
      const isUnlocked = Boolean(unlocked[a.id]);
      return `
        <div class="achievement-card ${isUnlocked ? 'is-unlocked' : ''}">
          <span class="achievement-status">${isUnlocked ? '✓' : '?'}</span>
          <div>
            <h2>${a.label}</h2>
            <p>${isUnlocked ? a.explanation : a.clue}</p>
          </div>
        </div>
      `;
    }).join('');
  }

  const allUnlocked = ACHIEVEMENTS.every((a) => unlocked[a.id]);
  if (allUnlocked && reward) {
    reward.hidden = false;
    launchConfetti('You found everything! 🎉');
  }

  const arcadeFrame = document.getElementById('arcade-frame') as HTMLIFrameElement | null;
  const arcadeTabs = document.querySelectorAll<HTMLButtonElement>('.arcade-tab');

  arcadeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      arcadeTabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      if (arcadeFrame) {
        arcadeFrame.src = `/arcade/${tab.dataset.game}/index.html`;
      }
    });
  });
</script>
